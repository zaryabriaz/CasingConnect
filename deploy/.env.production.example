# Copy to .env.production on the server (never commit real secrets)
POSTGRES_PASSWORD=change-me-strong-db-password
JWT_SECRET=change-me-long-random-secret-at-least-32-chars
JWT_EXPIRES_SECONDS=2592000
CORS_ORIGINS=https://casingconnect.com,https://www.casingconnect.com
NEXT_PUBLIC_API_URL=https://casingconnect.com/api/v1
NEXT_PUBLIC_SITE_URL=https://casingconnect.com
# Optional captcha signing secret (defaults to JWT_SECRET)
CAPTCHA_SECRET=

# Email new tailored-setup requests to info@casingconnect.com
MAIL_TO=info@casingconnect.com
MAIL_FROM=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
