DATABASE_URL="postgresql://casingconnect:casingconnect@127.0.0.1:5434/casingconnect"
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_SECONDS="2592000"
PORT="3010"
CORS_ORIGINS="http://localhost:3011"
# Optional — defaults to JWT_SECRET. Used to sign free built-in captcha challenges.
CAPTCHA_SECRET=""

# Email — free Resend SMTP (verify casingconnect.com in Resend, then paste API key)
MAIL_TO="info@casingconnect.com"
MAIL_FROM="info@casingconnect.com"
SMTP_HOST="smtp.resend.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="resend"
SMTP_PASS=""
